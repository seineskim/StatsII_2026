set.seed(123)
# 1. Generate data: 1000 Cauchy random variables
data <- rcauchy(1000, location = 0, scale = 1)
# 2. Function to calculate KS Statistic (D)
# comparing empirical CDF vs Theoretical Normal CDF
calculate_ks_stat <- function(x) {
# Sort data
x_sorted <- sort(x)
n <- length(x)
# Empirical CDF values: i/n
emp_cdf <- (1:n) / n
# Theoretical CDF values (Standard Normal)
theo_cdf <- pnorm(x_sorted, mean = 0, sd = 1)
# D statistic: max absolute difference
# Note: Ideally we check both |F(x) - i/n| and |F(x) - (i-1)/n|
# But adhering to the hint structure:
D <- max(abs(emp_cdf - theo_cdf))
return(D)
}
D_stat <- calculate_ks_stat(data)
print(paste("KS Statistic D:", D_stat))
# 3. Function to calculate p-value using the provided formula
# p(D <= d) = (sqrt(2pi)/d) * sum(exp(...))
calculate_ks_pvalue <- function(d) {
sum_term <- 0
# Infinite sum approximation
# We iterate until the term becomes negligible
for(k in 1:1000) {
term <- exp(-((2*k - 1)^2 * pi^2) / (8 * d^2))
sum_term <- sum_term + term
# Convergence check
if(term < 1e-15) break
}
p_val <- (sqrt(2 * pi) / d) * sum_term
return(p_val)
}
# 3. Function to calculate p-value using the provided formula
# p(D <= d) = (sqrt(2pi)/d) * sum(exp(...))
calculate_ks_pvalue <- function(d) {
sum_term <- 0
# Infinite sum approximation
# We iterate until the term becomes negligible
for(k in 1:1000) {
term <- exp(-((2*k - 1)^2 * pi^2) / (8 * d^2))
sum_term <- sum_term + term
# Convergence check
if(term < 1e-15) break
}
p_val <- (sqrt(2 * pi) / d) * sum_term
return(p_val)
}
# The formula in the PDF calculates the CDF of the KS distribution.
# High D statistic means the distributions are different.
# Typically p-value is the probability of observing a D as extreme or more extreme.
# However, we will report the value resulting from the provided formula.
p_value <- calculate_ks_pvalue(D_stat)
print(paste("Calculated Value from Formula:", p_value))
# 3. Function to calculate p-value using the provided formula
# p(D <= d) = (sqrt(2pi)/d) * sum(exp(...))
calculate_ks_pvalue <- function(d) {
sum_term <- 0
# Infinite sum approximation
# We iterate until the term becomes negligible
for(k in 1:1000) {
term <- exp(-((2*k - 1)^2 * pi^2) / (8 * d^2))
sum_term <- sum_term + term
# Convergence check
if(term < 1e-15) break
}
p_val <- (sqrt(2 * pi) / d) * sum_term
return(p_val)
}
# The formula in the PDF calculates the CDF of the KS distribution.
# High D statistic means the distributions are different.
# Typically p-value is the probability of observing a D as extreme or more extreme.
# However, we will report the value resulting from the provided formula.
p_value <- calculate_ks_pvalue(D_stat)
print(paste("Calculated Value from Formula:", p_value))
set.seed(123)
# 1. Create Data (Given in instructions)
X <- cbind(1, runif(100))
theta.true <- c(-1, 2)
y <- X %*% theta.true + rnorm(100)
# 2. Define Objective Function (Sum of Squared Errors)
# We want to minimize this function
ols_loss_function <- function(theta, y, X) {
# Predicted values
y_pred <- X %*% theta
# Sum of squared residuals
ssr <- sum((y - y_pred)^2)
return(ssr)
}
# 3. Run Optimization (BFGS)
# Initial guess for theta (e.g., 0, 0)
initial_theta <- c(0, 0)
opt_result <- optim(par = initial_theta,
fn = ols_loss_function,
y = y,
X = X,
method = "BFGS")
print("Estimated Coefficients (BFGS):")
print(opt_result$par)
# 4. Compare with lm()
lm_result <- lm(y ~ X[,2]) # X[,2] is the predictor, X[,1] is intercept
print("Estimated Coefficients (lm):")
print(coef(lm_result))
# Check equivalence
diff <- sum(abs(opt_result$par - coef(lm_result)))
print(paste("Difference between BFGS and lm:", diff))
