#####################
# Problem 1
#####################
# load data
load(url("https://github.com/ASDS-TCD/StatsII_2026/blob/main/datasets/climateSupport.RData?raw=true"))
str(climateSupport)
summary(climateSupport)
#1. Additive Model
model_additive <- glm(choice ~ countries + sanctions,
data = climateSupport,
family = binomial(link = "logit"))
summary(model_additive)
#Compare with null model
model_null <- glm(choice ~ 1,
data = climateSupport,
family = binomial(link = "logit"))
anova(model_null, model_additive, test = "LRT")
#####################
# Problem 2
#####################
#2(a) & 2(b) Interpret coefficient Odds
odds_ratios <- exp(coef(model_additive))
print("Estimated Odds Ratios:")
print(odds_ratios)
#Calculate the change in odds when sanctions increase from 5% to 15%
## Note: Since this is an additive model, the ratio of the change in odds is the same
# Formula: OR = exp(beta_15% - beta_5%) or Odds_15% / Odds_5%
or_sanctions_5_to_15 <- odds_ratios["sanctions15%"] / odds_ratios["sanctions5%"]
cat("Odds change when sanctions increase from 5% to 15%:", round(or_sanctions_5_to_15, 3), "\n")
# 2(c) Estimated probability for 80 countries and no sanctions
# Define the condition: 80 countries participating and "None" for sanctions.
new_obs <- data.frame(countries = "80", sanctions = "None")
# Using the predict() function with type="response" calculates the predicted probability P(Y=1|X)
pred_prob <- predict(model_additive, newdata = new_obs, type = "response")
# 2(c) Estimated probability for 80 countries and no sanctions
# Define the condition: 80 countries participating and "None" for sanctions.
new_obs <- data.frame(countries = "80 of 192", sanctions = "None")
# Using the predict() function with type="response" calculates the predicted probability P(Y=1|X)
pred_prob <- predict(model_additive, newdata = new_obs, type = "response")
cat("Estimated probability for 80 countries with no sanctions:", round(pred_prob, 3), "\n")
model_interaction <- glm(choice ~ countries * sanctions,
data = climateSupport,
family = binomial(link = "logit"))
summary(model_interaction)
# Compare the additive model and the interaction model using a Likelihood Ratio Test (LRT)
# This test determines if including the interaction term significantly improves the model's fit
anova(model_additive, model_interaction, test = "LRT")
