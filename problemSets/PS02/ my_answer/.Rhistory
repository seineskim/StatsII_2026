#####################
# Problem 1
#####################
# load data
load(url("https://github.com/ASDS-TCD/StatsII_2026/blob/main/datasets/climateSupport.RData?raw=true"))
str(climateSupport)
summary(climateSupport)
#1. Additive Model
model_additive <- glm(choice ~ countries + sanctions,
data = climateSupport,
family = binomial(link = "logit"))
summary(model_additive)
#Compare with null model
model_null <- glm(choice ~ 1,
data = climateSupport,
family = binomial(link = "logit"))
anova(model_null, model_additive, test = "LRT")
#####################
# Problem 2
#####################
# 1. Convert variable types to regular Factors (to facilitate easier interpretation of coefficients)
# This removes the polynomial contrasts (.L, .Q) seen previously and provides dummy variable coefficients.
climateSupport$countries <- factor(climateSupport$countries, ordered = FALSE)
climateSupport$sanctions <- factor(climateSupport$sanctions, ordered = FALSE)
# 2. Re-fit the additive logistic regression model
# This model predicts support likelihood based on country participation and sanctions.
model_additive <- glm(choice ~ countries + sanctions,
data = climateSupport,
family = binomial(link = "logit"))
# 3. Calculate Odds Ratios (exponentiating the coefficients)
# Category-specific names will now appear in the output (e.g., sanctions5%, sanctions15%).
odds_ratios <- exp(coef(model_additive))
print(odds_ratios)
# Deriving answers for 2(a) & 2(b): Change in odds when sanctions increase from 5% to 15%.
# We calculate the ratio of the 15% odds ratio relative to the 5% odds ratio to determine the change.
or_change <- odds_ratios["sanctions15%"] / odds_ratios["sanctions5%"]
cat("Odds ratio change from 5% to 15% sanctions:", or_change, "\n")
# 2(c) Predicted probability for 80 countries participating with no sanctions ("None").
# Using the predict function with type="response" gives the probability scale (0 to 1).
new_obs <- data.frame(countries = "80 of 192", sanctions = "None")
pred_prob <- predict(model_additive, newdata = new_obs, type = "response")
cat("Estimated probability (80 countries, No sanctions):", pred_prob, "\n")
# 3. Test for interaction effects.
# Compare the additive model to a model including an interaction term using a Likelihood Ratio Test (LRT).
model_interaction <- glm(choice ~ countries * sanctions,
data = climateSupport,
family = binomial(link = "logit"))
# The LRT determines if adding the interaction term significantly improves the model fit.
anova(model_additive, model_interaction, test = "LRT")
#####################
# Problem 3
#####################
model_interaction <- glm(choice ~ countries * sanctions,
data = climateSupport,
family = binomial(link = "logit"))
summary(model_interaction)
# Compare the additive model and the interaction model using a Likelihood Ratio Test (LRT)
# This test determines if including the interaction term significantly improves the model's fit
anova(model_additive, model_interaction, test = "LRT")
# 2(a) Interpretation: Odds change for 160 participating countries
# Since model_additive is an additive model, we interpret the coefficient
# of sanctions independently of the participation level.
# Extract estimated Odds Ratios (exponentiated coefficients)
odds_ratios <- exp(coef(model_additive))
# Calculate the change in odds when sanctions increase from 5% to 15%
# Change = Odds(15%) / Odds(5%)
or_change_a <- odds_ratios["sanctions15%"] / odds_ratios["sanctions5%"]
print(paste("Change in odds (160 countries):", round(or_change_a, 3)))
new_obs_c <- data.frame(countries = "80 of 192", sanctions = "None")
# predict() with type="response" gives the probability P(Y=1|X)
prob_c <- predict(model_additive, newdata = new_obs_c, type = "response")
print(paste("Estimated Probability:", round(prob_c, 3)))
model_interaction <- glm(choice ~ countries * sanctions,
data = climateSupport,
family = binomial(link = "logit"))
summary(model_interaction)
# Compare the additive model and the interaction model using a Likelihood Ratio Test (LRT)
# This test determines if including the interaction term significantly improves the model's fit
anova(model_additive, model_interaction, test = "LRT")
